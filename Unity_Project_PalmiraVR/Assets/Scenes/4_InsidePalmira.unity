      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 8672059217284661870, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_text
      value: "Situata nel <color=#D1AD6B><b>cuore del deserto siriano,</b></color>\nPalmira
        fu ufficialmente annessa all\u2019Impero Romano nel I secolo d.C., sotto
        l\u2019imperatore Tiberio.\n\nLungi dall\u2019essere un insediamento periferico,
        la citt\xE0 divenne un crocevia cosmopolita tra Roma, la Persia e le rotte
        carovaniere orientali.\nTra la fine del II e l\u2019inizio del III secolo
        d.C., durante la dinastia dei Severi,\nPalmira visse la sua Et\xE0 dell\u2019Oro.\n\nIn
        questo periodo di prosperit\xE0, il teatro fu ampliato e riccamente decorato,\ndiventando
        il simbolo di una citt\xE0 che si considerava una capitale culturale del
        mondo antico.\n<color=#D1AD6B><b> \r</b></color>                \n\n\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8672059217284661870, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_fontSize
      value: 28
      objectReference: {fileID: 0}
    - target: {fileID: 8672059217284661870, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_fontSizeBase
      value: 28
      objectReference: {fileID: 0}
