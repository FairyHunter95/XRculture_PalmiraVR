  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Teatro romano di Palmira \r\npresso il Sito Archeologico di Palmira (Siria)
    \r\n\r\n\n\r\n\n\n\n\n\n\n\n\n\n\n\nGrazie di aver preso parte a questo viaggio
    indietro nel tempo! \r\n\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nApplicazione sviluppata
    nell\u2019ambito di\r\nXR CULTURE \r\nCo-founded by the European Union\r\n\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nProgetto
    a cura del Dipartimento DICEA\r\ndell\u2019Universit\xE0 Politecnica delle Marche\r\n\r\n\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nSupervisione
    scientifica a cura di: \r\n\n\nProf.ssa Ramona Quattrini\r\nProf. Roberto Pierdicca\r\nIng.
    PhD Francesco Di Stefano\r\n\r\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nSviluppo e contenuti
    digitali a cura di:\r\n\n\nMatteo Caponi\r\nPaolo Pieruccini\r\nCecilia Ruggieri\r\n\r\n\n\r\n\n\n\n\n\n\n\n\n\n\n\r\nIn
    memoria del Prof. Gabriele Fangi\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
