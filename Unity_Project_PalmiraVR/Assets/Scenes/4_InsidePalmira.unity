    - target: {fileID: 3193289928362775871, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_text
      value: "<b>Osserva la mappa</b>\nNel pannello accanto puoi vedere l\u2019Impero
        Romano nella sua massima estensione.\nProva a individuare Palmira nel deserto
        siriano, a nord-est di Damasco."
      objectReference: {fileID: 0}
    - target: {fileID: 3193289928362775871, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_fontSize
