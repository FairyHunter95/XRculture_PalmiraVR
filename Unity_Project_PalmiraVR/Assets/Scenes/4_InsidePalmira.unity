      objectReference: {fileID: 0}
    - target: {fileID: 8672059217284661870, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_text
      value: "Il capitello corinzio \xE8 uno degli elementi pi\xF9 raffinati dell\u2019architettura
        romana.\nLe foglie d\u2019acanto scolpite e le volute ricurve verso l\u2019esterno
        creano una ricca decorazione floreale che contrasta con la sobriet\xE0 del
        fusto della colonna.\n\nA Palmira, l\u2019uso dell\u2019ordine corinzio non
        aveva solo una funzione decorativa, ma anche simbolica.\nLa pianta di acanto
        non cresce nel deserto siriano: la sua rappresentazione esprime lusso, maestria
        artigianale e un chiaro legame culturale con l\u2019Impero Romano.\n\n<b>Esplora
        il capitello</b>\nIl capitello davanti a te pu\xF2 essere osservato da vicino.\nUtilizza
        il pannello accanto per modificare il materiale di visualizzazione ed esaminarne
        i dettagli..\n"
      objectReference: {fileID: 0}
    - target: {fileID: 8672059217284661870, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_fontSize
      value: 28
      objectReference: {fileID: 0}
    - target: {fileID: 8672059217284661870, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_fontSizeBase
      value: 28
      objectReference: {fileID: 0}
