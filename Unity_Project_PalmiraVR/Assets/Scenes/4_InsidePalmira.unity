    - target: {fileID: 8288929299144430161, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_LocalEulerAnglesHint.y
      value: 159.894
      objectReference: {fileID: 0}
    - target: {fileID: 8288929299144430161, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
