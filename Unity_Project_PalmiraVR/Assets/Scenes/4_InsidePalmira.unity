    - target: {fileID: 3193289928362775871, guid: ec022ff64f3996240bb137ab8d97fd46, type: 3}
      propertyPath: m_text
      value: "<color=#DFA400><b>Nicchie per statue</b></color>\nTra le colonne si
        trovano nicchie incassate che originariamente ospitavano statue di divinit\xE0,
        eroi e imperatori.\nLa nicchia centrale \xE8 tradizionalmente associata a
        una statua di Nerone, ricordato in Oriente come patrono del teatro e delle
        arti."
      objectReference: {fileID: 0}
